# pp1 configuration template.
#
# `pp1 onboard` writes .env for you; this file is the reference for every key.
# .env is read twice: by docker compose (interpolation) and by the brain
# container (env_file). Re-running onboard keeps keys you added by hand.

# ── ports on the host ────────────────────────────────────────────────────
PP1_TTS_PORT=6677
PP1_STT_PORT=8082
PP1_BRAIN_PORT=8787

# ── image tags ───────────────────────────────────────────────────────────
PP1_TTS_IMAGE=pp1/tts:latest
PP1_ASR_IMAGE=pp1/asr:latest
PP1_BRAIN_IMAGE=pp1/brain:latest

# ── TTS (moss-tts-windowed) ──────────────────────────────────────────────
# container files are written as this uid/gid
MOSS_UID=1000
MOSS_GID=1000

MOSS_MODELS_HOST=./models/tts
MOSS_MODEL_FILE=moss_tts_v15_firstclass_q4_k_m_aq8.gguf
MOSS_DECODER_FILE=moss_tts_audio_decoder_f16.gguf

# parallel resident daemons: each costs ~6.8 GB VRAM
MOSS_DAEMONS=1

MOSS_LANGUAGE=zh
MOSS_AUDIO_TEMPERATURE=1.7
MOSS_AUDIO_TOP_P=0.8
MOSS_AUDIO_TOP_K=25
MOSS_AUDIO_REPETITION_PENALTY=1.0

MOSS_STREAM_WINDOW=32
MOSS_STREAM_OVERLAP=40
MOSS_STREAM_LOOKAHEAD=0
MOSS_CTX_ROWS=6000
MOSS_CTX_KEEP=2048
MOSS_PREFILL_UBATCH=384
MOSS_PREFILL_BUDGET_MIB=1000

MOSS_MAX_INPUT_CHARS=2048
MOSS_QUEUE_MAX=8
MOSS_QUEUE_WAIT=60
MOSS_LOG_TEXT=0
MOSS_DISABLE_NONSTREAM=1

# ── brain (pp-brain-server) ──────────────────────────────────────────────
# Service names below resolve inside the compose network.
STT_API_BASE_URL=http://asr:8082/v1
STT_API_KEY=
STT_MODEL=qwen-asr

TTS_API_BASE_URL=http://tts:8080/v1
TTS_API_KEY=
TTS_VOICE=male-fun

# REQUIRED. Used by the brain's asynchronous ASR revision: every 3 history
# writes it sends the latest audio clips as OpenAI `input_audio` parts (base64
# Ogg/Opus) and asks whether a transcript may have misled the agent. A
# `notify(warning)` tool call becomes an <asr-warning> in the agent queue
# (/brain-to-agent), so the agent can correct its later work.
# The endpoint must natively accept audio input: Qwen2.5-Omni, Voxtral, Gemini,
# GPT-4o-audio, or your own vLLM/SGLang audio model. A text-only model gets the
# request but rejects the audio part.
MIGHT_CHAT_API_BASE_URL=https://api.example.com/v1
# Any non-empty value when the endpoint has no auth (the brain refuses to start
# with an empty key).
MIGHT_CHAT_API_KEY=none
MIGHT_CHAT_MODEL=your-audio-model

MIGHT_BRAINS_PORT=8787
MIGHT_BRAINS_TOKEN=
MIGHT_LOG_LLM=0
